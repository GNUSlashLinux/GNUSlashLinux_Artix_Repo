pkgname=noctalia-git
pkgver=0
pkgrel=1
pkgdesc="A sleek, customizable desktop shell crafted for Wayland."
arch=('x86_64')
url="https://github.com/noctalia-dev/noctalia"
license=('MIT')

depends=(
    wayland
    wayland-protocols
    libglvnd
    freetype2
    fontconfig
    cairo
    pango
    harfbuzz
    libxkbcommon
    glib2
    libsecret
    libsodium
    sdbus-cpp
    libpipewire
    wireplumber
    polkit
    pam
    curl
    libwebp
    libjxl
    libsndfile
    librsvg
    libqalculate
    libxml2
    md4c
    tomlplusplus
    libical
    nlohmann-json
    stb
)

optdepends=(
    'upower: battery information'
    'ddcutil: monitor brightness control'
    'git: plugin auto-update support'
)

makedepends=(
    git
    meson
    ninja
    gcc
)

source=(
    "git+https://github.com/noctalia-dev/noctalia.git"
)

sha256sums=('SKIP')

pkgver() {
    cd noctalia

    printf "r%s.%s" \
        "$(git rev-list --count HEAD)" \
        "$(git rev-parse --short HEAD)"
}

build() {
    arch-meson noctalia build \
        -Dbuildtype=release \
        -Dtests=disabled

    meson compile -C build
}

package() {
    meson install -C build \
        --destdir "$pkgdir"
}
